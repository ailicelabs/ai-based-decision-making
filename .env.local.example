# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Il modello deve supportare le immagini (vision). gpt-4o va bene.
OPENAI_MODEL=gpt-4o
# Temperatura 0–1 (più bassa = risposte più coerenti). Default 0.3.
OPENAI_TEMPERATURE=0.3

# --- Sessione: stringa casuale lunga per firmare il cookie ---
SESSION_SECRET=cambia-questa-stringa-con-una-casuale

# --- Codici di accesso (opachi: NON devono rivelare il gruppo) ---
# Scenario METEO (attività in italiano)
ACCESS_CODE_GROUP_A=alpha-7421
ACCESS_CODE_GROUP_B=bravo-3856
ACCESS_CODE_GROUP_C=charlie-9012
ACCESS_CODE_GROUP_D=delta-6473
# Scenario MEDICINE (attività in inglese): 8 squadre, 2 per orientamento.
# Mappatura fissa: squadre 1-2 = A, 3-4 = B, 5-6 = C, 7-8 = D (lib/conditions.ts).
ACCESS_CODE_MED_TEAM_1=med-team-1
ACCESS_CODE_MED_TEAM_2=med-team-2
ACCESS_CODE_MED_TEAM_3=med-team-3
ACCESS_CODE_MED_TEAM_4=med-team-4
ACCESS_CODE_MED_TEAM_5=med-team-5
ACCESS_CODE_MED_TEAM_6=med-team-6
ACCESS_CODE_MED_TEAM_7=med-team-7
ACCESS_CODE_MED_TEAM_8=med-team-8

# --- Area admin (/admin): risultati del voto, apertura/chiusura, export ---
# Senza ADMIN_CODE l'area admin resta chiusa.
ADMIN_CODE=cambia-questo-codice-admin

# --- Database (in locale opzionale; su Vercel lo crea l'integrazione Neon) ---
# Se assente, il log delle conversazioni viene disattivato.
# DATABASE_URL=postgres://...
